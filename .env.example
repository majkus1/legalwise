# Szablon konfiguracji. Skopiuj do .env.local i uzupełnij.
# Plik .env.local NIE trafia do repozytorium.

# Supabase — adres projektu i klucze.
# Lokalnie: wartości zwracane przez `npm run db:start`.
# Produkcyjnie: projekt w regionie EU (Frankfurt) — wymóg wynikający
# z tajemnicy zawodowej i RODO.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Klucz serwisowy omija RLS. Używany wyłącznie po stronie serwera i tylko tam,
# gdzie jest to konieczne — nigdy w kodzie wysyłanym do przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=

# Adres aplikacji, używany w linkach wysyłanych mailem (np. reset hasła).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Wysyłka poczty przez Resend — OPCJONALNA alternatywa dla SMTP poniżej.
# Gdy ustawiony jest RESEND_API_KEY, ma pierwszeństwo przed SMTP.
# Zostaw puste, jeśli wysyłasz przez własny serwer SMTP.
RESEND_API_KEY=
RESEND_FROM=

# Web Push (VAPID). Wygenerowanie pary: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Hasło kont demonstracyjnych (`npm run db:seed`) oraz testów e2e.
# Wyłącznie dla środowiska lokalnego — zasiew odmawia uruchomienia na
# jakiejkolwiek bazie poza localhost. Na produkcji zostaw puste.
DEMO_PASSWORD=

# Sekret dla crona porannego przeglądu.
# Endpoint bez ustawionego sekretu odmawia obsługi (fail-closed) — brak
# konfiguracji nie może oznaczać publicznie dostępnego wywołania.
CRON_SECRET=

# Poczta przez własny serwer SMTP. Gdy nie ustawiono ani Resend, ani SMTP,
# lokalnie wiadomości przechwytuje Mailpit, a na produkcji trafiają wyłącznie
# do logu — aplikacja nie udaje wtedy, że coś wysłała.
#
# Gmail: wymaga HASŁA APLIKACJI, nie zwykłego hasła do konta. Generuje się je
# na koncie Google po włączeniu weryfikacji dwuetapowej. SMTP_USER i SMTP_FROM
# muszą być tym samym adresem — Gmail nie pozwala podszyć się pod inny.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#
# Limit zwykłego Gmaila to ok. 500 wiadomości na dobę (Workspace: 2000).
# Dla kancelarii na start wystarczy; docelowo lepiej nadawać z ich domeny,
# żeby powiadomienia nie przychodziły z prywatnego adresu wykonawcy.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# UWAGA: to ustawienie obsługuje WYŁĄCZNIE powiadomienia wysyłane przez
# aplikację (poranny przegląd, alerty). Maile uwierzytelniania — reset hasła
# i zaproszenia — wysyła Supabase i ma własną konfigurację SMTP w panelu
# projektu (Authentication → Emails → SMTP Settings). Bez niej Supabase
# ogranicza wysyłkę do kilku wiadomości na godzinę.
